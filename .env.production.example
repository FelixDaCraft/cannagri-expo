# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values
# ===========================================

# Database
POSTGRES_USER=cannagri
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=cannagri

# App
APP_PORT=3000
NEXT_PUBLIC_APP_URL=https://cannagri-expo.fr
NEXTAUTH_URL=https://cannagri-expo.fr
NEXTAUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32

# Viva Wallet API (Production)
VIVA_WALLET_CLIENT_ID=your_client_id
VIVA_WALLET_CLIENT_SECRET=your_client_secret
VIVA_WALLET_MERCHANT_ID=your_merchant_id
VIVA_WALLET_API_KEY=your_api_key
VIVA_WALLET_SOURCE_CODE=your_source_code
VIVA_WALLET_DEMO_MODE=false

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=contact@cannagri-expo.fr
