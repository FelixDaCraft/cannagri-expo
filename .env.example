# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cannagri?schema=public"

# =============================================================================
# NextAuth Configuration
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# =============================================================================
# OAuth Providers (optional - leave empty to disable)
# =============================================================================

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
# Create at: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# GitHub OAuth
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Apple OAuth
# Create at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# =============================================================================
# Stripe Payment Processing
# =============================================================================
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""

# Webhook secret for payment confirmations
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# Legacy Payment (Viva Wallet) - Optional
# =============================================================================
VIVA_WALLET_CLIENT_ID=""
VIVA_WALLET_CLIENT_SECRET=""
VIVA_WALLET_MERCHANT_ID=""
VIVA_WALLET_API_KEY=""
VIVA_WALLET_SOURCE_CODE=""
VIVA_WALLET_DEMO_MODE="true"

# =============================================================================
# Email (Nodemailer)
# =============================================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@cannagri-expo.fr"

# =============================================================================
# Application Settings
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_EVENT_DATE="2026-03-28"
NEXT_PUBLIC_EVENT_LOCATION="L'Agronaute, Nantes"

# =============================================================================
# Media Storage (for gallery images)
# =============================================================================
# Local path where uploaded media files are stored
MEDIA_UPLOAD_DIR="./public/uploads"
# Base URL for serving uploaded files
NEXT_PUBLIC_MEDIA_URL="/uploads"
