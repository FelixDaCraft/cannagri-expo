# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cannagri?schema=public"

# =============================================================================
# NextAuth Configuration
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# =============================================================================
# OAuth Providers (optional - leave empty to disable)
# =============================================================================

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth (optional)
# Create at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# =============================================================================
# Viva Wallet Payment Processing
# =============================================================================
# Get your credentials at: https://developer.vivawallet.com/
VIVA_WALLET_MERCHANT_ID=""
VIVA_WALLET_API_KEY=""
# Set to "true" for sandbox/demo mode, "false" for production
VIVA_WALLET_DEMO_MODE="true"

# =============================================================================
# Email (Nodemailer)
# =============================================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@cannagri-expo.fr"

# =============================================================================
# Application Settings
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_EVENT_DATE="2026-03-28"
NEXT_PUBLIC_EVENT_LOCATION="L'Agronaute, Nantes"

# =============================================================================
# Media Storage (for gallery images)
# =============================================================================
MEDIA_UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_MEDIA_URL="/uploads"
