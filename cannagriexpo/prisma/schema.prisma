// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ SPONSORS ============
enum SponsorType {
  PLATINE    // Partenaire principal - visibilité maximale, article en page d'accueil
  OR         // Partenaire Or - forte visibilité, en-tête site
  ARGENT     // Partenaire Argent - visibilité ciblée
  BRONZE     // Partenaire Bronze - soutien, bas de page
}

model Sponsor {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  type          SponsorType  @default(BRONZE)
  logoUrl       String?
  description   String?      @db.Text
  websiteUrl    String?

  // Champs spécifiques Premium (article home)
  articleTitle  String?
  articleBody   String?      @db.Text
  articleImage  String?

  // ============ TRADUCTIONS ============
  // Stockage JSON: { "en": "...", "de": "...", "es": "...", "it": "..." }
  articleTitleTranslations  Json?    // Traductions du titre de l'article
  articleBodyTranslations   Json?    // Traductions du corps de l'article
  descriptionTranslations   Json?    // Traductions de la description

  // ============ EXPOSANT ============
  // Relation avec le stand attribué
  standId       String?      @unique
  stand         Stand?       @relation(fields: [standId], references: [id])

  // Informations exposant pour la page /exposants
  exhibitorDescription String?    @db.Text  // Description de l'activité
  exhibitorCategory    BusinessType?        // Catégorie métier
  contactName          String?              // Nom du contact
  contactEmail         String?              // Email de contact
  contactPhone         String?              // Téléphone de contact

  // Traduction de la description exposant
  exhibitorDescriptionTranslations Json?   // Traductions de la description exposant

  // Position d'affichage
  displayOrder  Int          @default(0)
  isActive      Boolean      @default(true)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}


// ============ STANDS ============
enum StandStatus {
  FREE
  RESERVED
  SOLD
}

enum StandSize {
  SMALL      // 6-9 m²
  MEDIUM     // 12-18 m²
  LARGE      // 24+ m²
}

model Stand {
  id            String       @id @default(cuid())
  number        Int          @unique  // Numéro du stand (1-25)
  code          String       @unique  // Alias pour compatibilité
  surfaceM2     Float
  priceHT       Float
  status        StandStatus  @default(FREE)
  size          StandSize    @default(MEDIUM)

  // Nom affiché pour l'exposant (optionnel, sinon utilise companyName du PRO)
  exhibitorName String?

  // Lien vers compte Pro (exposant)
  proId         String?
  pro           User?        @relation(fields: [proId], references: [id])

  // Lien vers Sponsor (un sponsor a automatiquement un stand)
  sponsor       Sponsor?

  // Options
  hasFurniture  Boolean      @default(false)
  hasElectricity Boolean     @default(false)
  furniturePrice Float       @default(120)
  electricityPrice Float     @default(80)

  // Position sur le plan SVG
  x             Int          @default(0)
  y             Int          @default(0)
  width         Int          @default(55)
  height        Int          @default(55)

  // Anciens champs de grille (pour compatibilité)
  row           Int          @default(0)
  col           Int          @default(0)

  orderId       String?
  order         Order?       @relation(fields: [orderId], references: [id])

  // Réservation temporaire (expire après 15 min)
  reservedAt    DateTime?
  reservedUntil DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ============ BILLETTERIE ============
enum TicketType {
  STANDARD      // Billet Standard - Accès au salon
  FLEX          // Billet Flex - Soutien à l'association
}

enum TicketStatus {
  PENDING
  PAID
  CANCELLED
  USED
  EXPIRED
}

model Ticket {
  id            String        @id @default(cuid())
  customerName  String
  customerEmail String
  ticketType    TicketType    @default(STANDARD)
  ticketPrice   Float
  qrCodeData    String        @unique
  pdfUrl        String?
  status        TicketStatus  @default(PENDING)

  // Scan info
  scannedAt     DateTime?
  scannedBy     String?

  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ============ COMMANDES ============
enum OrderType {
  VISITOR_TICKET
  STAND_BOOKING
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique @default(cuid())
  type            OrderType
  amount          Float        // Montant en euros TTC
  amountHT        Float?       // Montant HT (pour les stands)
  tva             Float        @default(20)
  currency        String       @default("EUR")

  // Viva Wallet
  vivaWalletRef   String?      @unique
  vivaPaymentUrl  String?

  status          OrderStatus  @default(PENDING)

  // Infos client
  customerEmail   String
  customerName    String
  customerPhone   String?
  companyName     String?
  companySiret    String?
  companyAddress  String?

  // Notes
  notes           String?      @db.Text

  tickets         Ticket[]
  stands          Stand[]

  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ============ EVENEMENTS / PROGRAMME ============
enum EventType {
  CONFERENCE
  WORKSHOP
  CEREMONY
  BREAK
  NETWORKING
}

model Event {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  description     String?    @db.Text
  type            EventType
  startAt         DateTime
  endAt           DateTime
  location        String?    // Ex: "Salle A", "Scène principale"

  // Multiple speakers stored as JSON array
  // Format: [{ name, title, company, photo, bio }]
  speakers        Json?      @default("[]")

  // Legacy single speaker fields (kept for backwards compatibility)
  speakerName     String?
  speakerTitle    String?
  speakerCompany  String?
  speakerPhoto    String?
  speakerBio      String?    @db.Text

  // Platinum CBD Cup
  isPlatinumCBDCup Boolean   @default(false)

  // Display
  isHighlighted   Boolean    @default(false)
  displayOrder    Int        @default(0)

  // ============ TRADUCTIONS ============
  // Stockage JSON: { "en": "...", "de": "...", "es": "...", "it": "..." }
  titleTranslations       Json?    // Traductions du titre
  descriptionTranslations Json?    // Traductions de la description

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ============ MEDIATHEQUE ============
model Media {
  id            String    @id @default(cuid())
  imageUrl      String
  thumbnailUrl  String?
  caption       String?
  altText       String?
  edition       String    // Ex: "2024", "2025"
  category      String?   // Ex: "Conférences", "Stands", "Remise des prix"

  displayOrder  Int       @default(0)

  createdAt     DateTime  @default(now())
}

// ============ UTILISATEURS (Auth) ============
enum UserRole {
  SUPER_ADMIN   // Accès total + gestion des rôles + invitations
  ADMIN         // Accès total sauf gestion des rôles
  CONTRIBUTOR   // Accès limité: Comptes Pro + Stands uniquement
  PRO           // Compte exposant professionnel
  USER          // Compte visiteur public (achat billets, pas d'accès admin)
}

enum BusinessType {
  PRODUCTEURS
  MATERIEL
  LIFESTYLE
  SERVICE
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  hashedPassword  String?       // Optional for OAuth users
  name            String?
  firstName       String?
  image           String?
  role            UserRole      @default(USER)

  // Profile Pro
  companyName        String?
  companyDescription String?        @db.Text  // Description de l'activité pour la page exposants
  companyLogo        String?        // URL du logo de l'entreprise
  companyWebsite     String?        // URL du site web de l'entreprise
  phone              String?
  siret              String?
  businessType       BusinessType?

  // Traductions de la description entreprise
  companyDescriptionTranslations Json?   // { "en": "...", "de": "...", "es": "...", "it": "..." }

  // Validation du compte PRO par un admin
  isApproved         Boolean       @default(false)

  // Security
  emailVerified   DateTime?
  resetToken      String?
  resetTokenExpiry DateTime?

  // NextAuth relations
  accounts        Account[]
  sessions        Session[]

  // Stands réservés par ce pro
  stands          Stand[]

  // Invitations envoyées (pour SUPER_ADMIN)
  invitationsSent TeamInvitation[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// NextAuth Account model for OAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth Verification Token (for email verification)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ NEWSLETTER ============
model NewsletterSubscriber {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  isActive      Boolean   @default(true)

  subscribedAt  DateTime  @default(now())
  unsubscribedAt DateTime?
}

// ============ CONTACT / DEMANDES ============
enum ContactType {
  GENERAL
  PRESS
  SPONSOR
  EXHIBITOR
}

model ContactRequest {
  id            String      @id @default(cuid())
  type          ContactType @default(GENERAL)
  name          String
  email         String
  phone         String?
  company       String?
  subject       String
  message       String      @db.Text

  isRead        Boolean     @default(false)
  isArchived    Boolean     @default(false)

  createdAt     DateTime    @default(now())
}

// ============ DEMANDES DE PLAQUETTE SPONSORING ============
enum SponsorRequestStatus {
  PENDING    // En attente
  SENT       // Plaquette envoyée
}

model SponsorRequest {
  id            String              @id @default(cuid())
  companyName   String
  contactName   String
  email         String
  phone         String?

  status        SponsorRequestStatus @default(PENDING)
  sentAt        DateTime?            // Date d'envoi de la plaquette

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// ============ ANALYTICS / VISITES ============
model PageView {
  id            String    @id @default(cuid())
  path          String    // URL de la page visitée
  userAgent     String?
  referrer      String?
  ip            String?   // Hash de l'IP pour anonymisation
  country       String?

  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([path])
}

model DailyStats {
  id            String    @id @default(cuid())
  date          DateTime  @unique @db.Date
  totalViews    Int       @default(0)
  uniqueVisitors Int      @default(0)

  // Pages les plus visitées (JSON)
  topPages      String?   @db.Text

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([date])
}

// ============ INVITATIONS EQUIPE ============
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model TeamInvitation {
  id            String           @id @default(cuid())
  email         String
  role          UserRole         @default(CONTRIBUTOR)
  token         String           @unique @default(cuid())
  status        InvitationStatus @default(PENDING)

  invitedById   String
  invitedBy     User             @relation(fields: [invitedById], references: [id])

  expiresAt     DateTime
  acceptedAt    DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([email])
  @@index([token])
}

// ============ SITE SETTINGS ============
model SiteSettings {
  id                    String    @id @default("site_settings")

  // Event info
  eventDate             DateTime?
  eventLocation         String?
  eventAddress          String?

  // Ticketing
  ticketingOpenDate     DateTime?
  ticketingCloseDate    DateTime?
  visitorTicketPrice    Float     @default(15)
  proTicketPrice        Float     @default(25)
  vipTicketPrice        Float     @default(75)

  // Display
  showTicketingButton   Boolean   @default(false)
  maintenanceMode       Boolean   @default(false)

  updatedAt             DateTime  @updatedAt
}
